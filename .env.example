# Copy to .env (git-ignored) and fill in the secrets:   cp .env.example .env && chmod 600 .env
# Every variable has a safe default except the three marked SECRET.

# ---------------------------------------------------------------- bridge HTTP API
BRIDGE_HOST=127.0.0.1                 # keep 127.0.0.1: only nginx (TLS) may reach the app
BRIDGE_PORT=8090
BRIDGE_ROOT_PATH=/bridge              # public prefix: https://wildcam.ecoscience.dk/bridge/
BRIDGE_API_KEY_HASHES=                # SECRET-ish: comma-separated sha256:... from `wildcam-bridge gen-api-key`
BRIDGE_REQUIRE_HTTPS=true             # reject requests that did not come through TLS
BRIDGE_ENABLE_DOCS=true               # interactive docs at /bridge/docs
BRIDGE_STATE_DIR=var                  # job DB, uploaded CSVs
BRIDGE_MAX_CSV_BYTES=20000000
BRIDGE_MAX_ROWS=20000

# ---------------------------------------------------------------- AU ERDA (SFTP, SSH-encrypted)
ERDA_HOST=io.erda.au.dk
ERDA_PORT=2222
ERDA_SHARELINK=                       # SECRET: sharelink id (used as SFTP username AND password)
ERDA_KNOWN_HOSTS=config/erda_known_hosts   # pinned host key, refuse anything else
ERDA_REMOTE_ROOT=                     # folder inside the share holding the CSV paths ("" = share root)
ERDA_STRIP_PREFIX=wildcams/           # the share root IS the "wildcams" folder of the CSV paths
ERDA_CONCURRENCY=8
ERDA_RETRIES=3

# ---------------------------------------------------------------- local media storage
LS_DATA_ROOT=/home/wildcam/labelstudio-data   # == LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT
LS_DATA_SUBDIR=bridge                         # videos go to $LS_DATA_ROOT/bridge/<job_id>/
DISK_RESERVE_GB=10                            # free space that must remain after a download

# ---------------------------------------------------------------- Label Studio
LS_URL=http://127.0.0.1:8081          # internal URL (no TLS hop needed on localhost)
LS_PUBLIC_URL=https://wildcam.ecoscience.dk
LS_API_TOKEN=                         # SECRET: Personal Access Token of the bridge service account
LS_LABEL_CONFIG=config/label_config.xml
LS_PREDICTION_FROM_NAME=species_label
