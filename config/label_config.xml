<View style="display: flex;">
  <View style="width: 74%; margin-right: 1.99%">
    <Video name="video" value="$video"/> 
    <!-- Single-label classification -->
  </View>

  <View style="width: 24%;">
    <Header value="Choose a species" />
    <Choices name="species_label" toName="video" choice="single" showInLine="true">
      <Choice value="badger"/>
      <Choice value="bear"/>
      <Choice value="beaver"/>
      <Choice value="bird"/>
      <Choice value="bison"/>
      <Choice value="cat"/>
      <Choice value="chamois"/>
      <Choice value="cow"/>
      <Choice value="dog"/>
      <Choice value="equid"/>
      <Choice value="fallow deer"/>
      <Choice value="fox"/>
      <Choice value="genet"/>
      <Choice value="goat"/>
      <Choice value="golden jackal"/>
      <Choice value="hedgehog"/>
      <Choice value="ibex"/>
      <Choice value="lagomorph"/>
      <Choice value="lynx"/>
      <Choice value="marmot"/>
      <Choice value="micromammal"/>
      <Choice value="moose"/>
      <Choice value="mouflon"/>
      <Choice value="muskrat"/>
      <Choice value="mustelid"/>
      <Choice value="nutria"/>
      <Choice value="otter"/>
      <Choice value="procupine"/>
      <Choice value="raccoon"/>
      <Choice value="raccoon dog"/>
      <Choice value="red deer"/>
      <Choice value="reindeer"/>
      <Choice value="roe deer"/>
      <Choice value="sheep"/>
      <Choice value="squirrel"/>
      <Choice value="wild boar"/>
      <Choice value="wolf"/>
      <Choice value="wolverine"/>
      <Choice value="human"/>
      <Choice value="vehicle"/>
      <Choice value="undefined"/>
      <Choice value="empty"/>
    </Choices>
    <!-- Numeric field for counts -->
    <Header value="Count" />
    <Number name="count" toName="video" min="0" max="100" value="1" label="Individual count"/>

    <Header value="Certainty" />
    <Choices name="certainty" toName="video" choice="single" showInLine="true">
      <Choice value="Absolute" />
      <Choice value="Moderate" />
      <Choice value="Unsure" />
    </Choices>

    <Header value="Day or night?" />
    <Choices name="day_night" toName="video" choice="single">
      <Choice value="Day" />
      <Choice value="Night" />
    </Choices>

    <Header value="Age" />
    <Choices name="age" toName="video" choice="single">
      <Choice value="Adult" />
      <Choice value="Juvenile" />
    </Choices>

    <Header value="Sex" />
    <Choices name="sex" toName="video" choice="single" showInLine="true">
      <Choice value="Male" />
      <Choice value="Female" />
      <Choice value="Unsure" />
    </Choices>

    <Header value="Same animal(s) as previous video?" />
    <Choices name="recurring_animal" toName="video" choice="single">
      <Choice value="Yes" />
    </Choices>

    <Header value="(If dog)" />
    <Choices name="leashed" toName="video" choice="single">
      <Choice value="Leashed" />
      <Choice value="Not leashed" />
    </Choices>

    <Header value="(If horse)" />
    <Choices name="horse_with_human" toName="video" choice="single">
      <Choice value="Human present" />
      <Choice value="No human present" />
    </Choices>

    <!-- Free text notes -->
    <Header value="Other notes" />
    <TextArea name="notes" toName="video" placeholder="Enter any observations here"/> 
  </View>
</View>